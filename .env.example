# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — ЕДИНЫЙ источник правды. Меняешь значение здесь — оно применяется
# и в docker-compose.yml (через ${...}), и в строках подключения ниже
# (через dotenv-expand: ${VAR} внутри DATABASE_URL разворачивается на лету).
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expence_tracker
POSTGRES_HOST=localhost
# Порт на хосте. Внутри контейнера PostgreSQL всегда 5432; наружу — 5433,
# т.к. 5432 занимает локальная служба postgresql-x64-18.
POSTGRES_PORT=5433

# Собирается из POSTGRES_* выше — руками менять не нужно.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Отдельная БД для e2e-тестов: они чистят таблицы между кейсами,
# поэтому боевую базу под них подставлять нельзя.
# Если не задать — имя выведется из DATABASE_URL с суффиксом _test.
TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}_test?schema=public"

# Backend (NestJS)
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"
