generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

/// Периодичность регулярного платежа: как часто он повторяется.
enum PaymentPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categories   Category[]
  transactions Transaction[]
  payments     Payment[]

  @@map("users")
}

model Category {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  color  String  @default("#6366f1")
  icon   String?
  userId String  @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments     Payment[]

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  date        DateTime
  userId      String          @db.Uuid
  categoryId  String          @db.Uuid
  createdAt   DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}

/// Регулярный платёж: шаблон повторяющейся операции (подписка, аренда, зарплата).
/// Сам по себе денег не двигает — при отметке об оплате из него создаётся Transaction,
/// а nextDueDate сдвигается на период вперёд.
model Payment {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  period      PaymentPeriod
  nextDueDate DateTime
  isActive    Boolean         @default(true)
  description String?
  userId      String          @db.Uuid
  categoryId  String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, nextDueDate])
  @@index([categoryId])
  @@map("payments")
}
